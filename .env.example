# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# AI 图片识别（默认复用 DeepSeek 配置；VISION_MODEL 需要支持图片输入）
VISION_ENABLED=true
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_IMAGE_MB=8

# Neo4j 数据库连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# 应用配置
APP_HOST=127.0.0.1
APP_PORT=8501
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# v2 Docker Compose
API_PORT=8000
WEB_PORT=3000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEXT_PUBLIC_MEDQA_API_URL=http://localhost:8000

# --- Public deployment (docker-compose.prod.yml) ---
# Domain whose A record points at the server. Do not include a scheme.
# For an IP-only HTTP smoke test, use e.g. MEDQA_DOMAIN=:80 instead.
MEDQA_DOMAIN=medqa.example.com
# Browser-visible origin, used by FastAPI CORS and the Web UI.
PUBLIC_ORIGIN=https://medqa.example.com

# Per-IP request limits (requests per minute) for the public demo.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_VISION_PER_MINUTE=10
RATE_LIMIT_TOOL_PER_MINUTE=40
RATE_LIMIT_GENERAL_PER_MINUTE=120
